# =========================================================
# ALLOWLIST. This repo is ~/.config and it is PUBLIC.
#
# Every tool on the machine writes into ~/.config: caches, logs, login
# state, API keys (stripe/ held live keys, github-copilot/ an OAuth
# token). So nothing at the top level is tracked unless it is named
# below. A new tool's directory stays invisible to `git status` until
# you decide to track it and add a `!/<dir>/` line here.
#
# Never add ssh/ — ssh/config is per-machine and restored by hand.
# =========================================================
/*

!/.gitignore
!/.gitattributes
!/.markdownlint.json
!/README.md
!/Makefile
!/bootstrap
!/mkdocs.yml
!/starship.toml

!/alacritty/
!/brief/
!/command-cheatsheets/
!/docker/
!/docs/
!/gh/
!/gh-dash/
!/ghostty/
!/git/
!/herdr/
!/k8s/
!/lazygit/
!/nvim/
!/scripts/
!/theme/
!/tmux/
!/zsh/

# ---------------------------------------------------------
# Inside the tracked directories. An allowlisted directory brings in
# everything under it, so state and generated files inside them are
# still listed one by one.
# ---------------------------------------------------------

.DS_Store
*.bak

# Theme fragments generated by scripts/theme from theme/palettes/*.sh.
# The palettes and theme/current ARE tracked; these derived files are
# not, so a theme switch doesn't show up as a diff in three files.
# Recreate with `theme regen`. (starship-current.toml and bat/ sit at
# the top level, so the allowlist already keeps them out.)
ghostty/theme.conf
alacritty/theme-current.toml
git/theme.gitconfig
k8s/k9s/skins/theme-current.yaml

# gh keeps the auth token in the keychain, so hosts.yml is just the
# logged-in account — still per-machine.
gh/hosts.yml

# k9s writes per-cluster state and screen dumps next to its config.
k8s/k9s/clusters/
k8s/k9s/benchmarks/
k8s/k9s/screen-dumps/

# Per-machine Ghostty overrides, included last by ghostty/config.
# Used to give macOS 26+ machines real macos-glass-* blur while the
# shared config keeps the numeric radius that works everywhere.
ghostty/local.conf

# Windows only — written/cloned by scripts/windows-setup
alacritty/local.toml
zsh/plugins/zsh-autosuggestions/
zsh/plugins/zsh-syntax-highlighting/

# zsh completion cache
zsh/.zcompdump*

# herdr writes runtime state next to its config
herdr/*
!herdr/config.toml
