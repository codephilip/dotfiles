# Everything here is read by Unix shells and tools, on every OS. With
# core.autocrlf=true (Git for Windows' default) scripts and .zshrc would
# be checked out CRLF, and bash/zsh choke on the \r.
* text=auto eol=lf
*.pdf binary
*.png binary
*.jpg binary
*.ico binary

# Lines ending in `# local-only` stay on this machine. The clean filter
# drops them before git stores the file, so they are never committed,
# while the working copy keeps them. bootstrap defines the filter in
# .git/config; see docs/maintenance.md.
gh-dash/config.yml filter=localonly
