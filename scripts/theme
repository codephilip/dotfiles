#!/usr/bin/env bash
# =========================================================
# theme — switch the colour scheme across every tool at once
#
#   theme                 show the active theme
#   theme list            list available themes
#   theme <name>          switch to <name>
#   theme next            cycle to the next theme
#   theme regen           re-emit generated files without switching
#   theme show            print the active palette as colour swatches
#
# ---------------------------------------------------------
# How this works
#
# theme/palettes/<name>.sh is the single source of truth: a
# sourceable file of THEME_* variables. Everything else is either
# generated from it or reads it at startup.
#
#   generated by this script (gitignored, never hand-edit):
#     ghostty/theme.conf        palette lines, included by ghostty/config
#     alacritty/theme-current.toml  ditto, imported by alacritty.toml
#     git/theme.gitconfig       delta syntax-theme, included by gitconfig
#     starship-current.toml     starship.toml with the palette line swapped;
#                               .zshrc points STARSHIP_CONFIG at it
#
#   read at startup by the tool itself:
#     zsh      sources theme/current + the palette, derives fzf/bat
#     nvim     reads theme/current in lua/config/theme.lua
#
# tmux is deliberately absent: its status line is two greys on
# bg=default, so it inherits the terminal background and needs no
# per-theme values. That is intentional -- do not add it here.
#
# ---------------------------------------------------------
# Picking up a switch
#
#   ghostty   ⌘⇧,  (reload config) -- no CLI equivalent exists
#   zsh       handled by the `theme` wrapper function in .zshrc,
#             which re-execs the shell; other open shells need
#             `exec zsh`
#   nvim      restart, or :Lazy reload
#   git/bat   next invocation, automatically
# =========================================================

set -euo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
THEME_DIR="$CONFIG/theme"
PALETTE_DIR="$THEME_DIR/palettes"
CURRENT_FILE="$THEME_DIR/current"

DEFAULT_THEME="tokyonight"

# --- Helpers ---------------------------------------------

die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }
note() { printf '\033[2m%s\033[0m\n' "$*"; }

available() {
  local f
  for f in "$PALETTE_DIR"/*.sh; do
    [ -e "$f" ] || continue
    basename "$f" .sh
  done
}

current_name() {
  if [ -r "$CURRENT_FILE" ]; then
    # Trim whitespace; tolerate a missing trailing newline.
    tr -d '[:space:]' < "$CURRENT_FILE"
  else
    printf '%s' "$DEFAULT_THEME"
  fi
}

# Source a palette into the current shell. Every generator below
# assumes this has run.
load_palette() {
  local name=$1
  local file="$PALETTE_DIR/$name.sh"
  [ -r "$file" ] || die "unknown theme '$name' (try: theme list)"
  # shellcheck disable=SC1090
  . "$file"
}

# --- Generators ------------------------------------------
# Each writes one tool's config fragment. They emit the palette
# itself rather than a `theme = <name>` reference, so there is
# exactly one place a colour is defined and no dependence on a
# given tool shipping a correctly-named built-in.

gen_ghostty() {
  local out="$CONFIG/ghostty/theme.conf"
  mkdir -p "$(dirname "$out")"
  cat > "$out" <<EOF
# GENERATED by scripts/theme -- do not edit.
# Source: theme/palettes/$THEME_NAME.sh ($THEME_LABEL)
# Included from ghostty/config. Change themes with: theme <name>

background = $THEME_BG
foreground = $THEME_FG
cursor-color = $THEME_CURSOR
cursor-text = $THEME_CURSOR_TEXT
selection-background = $THEME_SELECTION
selection-foreground = $THEME_FG

palette = 0=$THEME_BLACK
palette = 1=$THEME_RED
palette = 2=$THEME_GREEN
palette = 3=$THEME_YELLOW
palette = 4=$THEME_BLUE
palette = 5=$THEME_MAGENTA
palette = 6=$THEME_CYAN
palette = 7=$THEME_WHITE
palette = 8=$THEME_BR_BLACK
palette = 9=$THEME_BR_RED
palette = 10=$THEME_BR_GREEN
palette = 11=$THEME_BR_YELLOW
palette = 12=$THEME_BR_BLUE
palette = 13=$THEME_BR_MAGENTA
palette = 14=$THEME_BR_CYAN
palette = 15=$THEME_BR_WHITE
EOF
}

gen_alacritty() {
  local out="$CONFIG/alacritty/theme-current.toml"
  mkdir -p "$(dirname "$out")"
  cat > "$out" <<EOF
# GENERATED by scripts/theme -- do not edit.
# Source: theme/palettes/$THEME_NAME.sh ($THEME_LABEL)
# Imported from alacritty.toml. Change themes with: theme <name>

[colors.primary]
background = "$THEME_BG"
foreground = "$THEME_FG"

[colors.cursor]
cursor = "$THEME_CURSOR"
text   = "$THEME_CURSOR_TEXT"

[colors.selection]
background = "$THEME_SELECTION"
text       = "$THEME_FG"

[colors.normal]
black   = "$THEME_BLACK"
red     = "$THEME_RED"
green   = "$THEME_GREEN"
yellow  = "$THEME_YELLOW"
blue    = "$THEME_BLUE"
magenta = "$THEME_MAGENTA"
cyan    = "$THEME_CYAN"
white   = "$THEME_WHITE"

[colors.bright]
black   = "$THEME_BR_BLACK"
red     = "$THEME_BR_RED"
green   = "$THEME_BR_GREEN"
yellow  = "$THEME_BR_YELLOW"
blue    = "$THEME_BR_BLUE"
magenta = "$THEME_BR_MAGENTA"
cyan    = "$THEME_BR_CYAN"
white   = "$THEME_BR_WHITE"
EOF
}

gen_starship() {
  local src="$CONFIG/starship.toml"
  local out="$CONFIG/starship-current.toml"
  [ -r "$src" ] || return 0

  # starship.toml defines every palette and selects one with a top-level
  # `palette` key. Rather than editing the tracked file on each switch,
  # copy it with that one line rewritten.
  #
  # The ^ anchor matters: it matches only the top-level key, never the
  # `[palettes.<name>]` table headers further down.
  if ! grep -q "^\[palettes\.$THEME_NAME\]" "$src"; then
    note "starship.toml has no [palettes.$THEME_NAME] — prompt colours will not match"
  fi

  sed "s|^palette = .*|palette = '$THEME_NAME'|" "$src" > "$out"
}

gen_git() {
  local out="$CONFIG/git/theme.gitconfig"
  mkdir -p "$(dirname "$out")"
  # delta resolves syntax-theme against bat's theme registry, so the
  # name here is whatever bat knows -- see ensure_bat_themes.
  cat > "$out" <<EOF
# GENERATED by scripts/theme -- do not edit.
# Source: theme/palettes/$THEME_NAME.sh ($THEME_LABEL)
# Included from git/gitconfig. Change themes with: theme <name>

# Only the values that actually differ per theme. delta's own
# defaults for minus-/plus-style are left alone deliberately: they
# derive red/green from the terminal's ANSI palette, which this
# script already sets, so overriding them here would only risk
# making +/- lines indistinguishable.
[delta]
	syntax-theme = $THEME_BAT
	file-decoration-style = "$THEME_GREY ul"
	hunk-header-decoration-style = "$THEME_GREY box"
EOF
}

# bat ships Catppuccin and Solarized but not Tokyo Night. Fetch the
# upstream .tmTheme once and build the cache, so the theme name in
# the palette file is actually resolvable.
#
# Without this, BAT_THEME and delta's syntax-theme silently fall back
# to bat's default -- which is what the pre-switcher config was doing.
ensure_bat_themes() {
  local bat_themes
  bat_themes="$(bat --config-dir 2>/dev/null)/themes" || return 0
  local tn="$bat_themes/tokyonight_night.tmTheme"

  if [ ! -s "$tn" ]; then
    mkdir -p "$bat_themes"
    note "installing tokyonight_night.tmTheme into bat..."
    if curl -fsSL -o "$tn" \
      "https://raw.githubusercontent.com/folke/tokyonight.nvim/main/extras/sublime/tokyonight_night.tmTheme"
    then
      bat cache --build >/dev/null 2>&1 \
        && note "bat cache rebuilt" \
        || note "bat cache --build failed; run it manually"
    else
      rm -f "$tn"
      note "could not download the theme; bat will use its default"
    fi
  fi
}

# --- Commands --------------------------------------------

cmd_list() {
  local cur; cur="$(current_name)"
  local name
  for name in $(available); do
    ( load_palette "$name"
      if [ "$name" = "$cur" ]; then
        printf '\033[1m● %-18s %s\033[0m\n' "$THEME_NAME" "$THEME_BLURB"
      else
        printf '  %-18s \033[2m%s\033[0m\n' "$THEME_NAME" "$THEME_BLURB"
      fi )
  done
}

cmd_show() {
  load_palette "$(current_name)"
  printf '\n  \033[1m%s\033[0m \033[2m— %s\033[0m\n\n' "$THEME_LABEL" "$THEME_BLURB"
  printf '  normal  '; for i in 0 1 2 3 4 5 6 7; do printf '\033[4%dm   \033[0m' "$i"; done; printf '\n'
  printf '  bright  '; for i in 0 1 2 3 4 5 6 7; do printf '\033[10%dm   \033[0m' "$i"; done; printf '\n\n'
  printf '  bg %s   fg %s   grey %s\n' "$THEME_BG" "$THEME_FG" "$THEME_GREY"
  printf '  accent %s   orange %s\n' "$THEME_ACCENT" "$THEME_ORANGE"
  printf '  nvim %s   bat %s\n\n' "$THEME_NVIM" "$THEME_BAT"
}

cmd_regen() {
  local name=${1:-$(current_name)}
  load_palette "$name"
  ensure_bat_themes
  gen_ghostty
  gen_alacritty
  gen_git
  gen_starship
}

cmd_set() {
  local name=$1
  [ -r "$PALETTE_DIR/$name.sh" ] || die "unknown theme '$name' (try: theme list)"

  cmd_regen "$name"
  mkdir -p "$THEME_DIR"
  printf '%s\n' "$name" > "$CURRENT_FILE"

  printf '\033[32m✓\033[0m switched to \033[1m%s\033[0m\n' "$THEME_LABEL"
  note "ghostty: ⌘⇧, to reload   nvim: restart   zsh: exec zsh"
}

cmd_next() {
  local cur; cur="$(current_name)"
  # Built with a loop rather than `mapfile`, which macOS's bash 3.2
  # does not have.
  local -a all=() name
  for name in $(available); do all+=("$name"); done
  local n=${#all[@]} i
  [ "$n" -gt 0 ] || die "no palettes found in $PALETTE_DIR"
  for i in "${!all[@]}"; do
    if [ "${all[$i]}" = "$cur" ]; then
      cmd_set "${all[$(( (i + 1) % n ))]}"
      return
    fi
  done
  # Active theme isn't in the list (renamed or deleted) -- fall back.
  cmd_set "${all[0]}"
}

# --- Dispatch --------------------------------------------

case "${1:-}" in
  ""|current)  current_name; printf '\n' ;;
  list|ls)     cmd_list ;;
  show|swatch) cmd_show ;;
  regen)       cmd_regen; note "regenerated for $(current_name)" ;;
  next|cycle)  cmd_next ;;
  -h|--help|help)
    sed -n '3,10p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)           cmd_set "$1" ;;
esac
