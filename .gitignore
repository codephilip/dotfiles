.DS_Store
ssh/

# Previous Neovim configs, kept locally for reference only
nvim.bak/
nvim-bread-on-pinguins/

# Local backups
*.bak

# Generated docs site (source lives in docs/, build with `make docs`)
site/

# Theme fragments generated by scripts/theme from theme/palettes/*.sh.
# The palettes and theme/current ARE tracked; these derived files are
# not, so a theme switch doesn't show up as a diff in three files.
# Recreate with `theme regen`.
ghostty/theme.conf
alacritty/theme-current.toml
git/theme.gitconfig
starship-current.toml
k8s/k9s/skins/theme-current.yaml

# bat's compiled theme cache, built by `theme` after fetching
# tokyonight_night.tmTheme.
bat/themes/
bat/metadata.yaml
bat/themes.bin
bat/syntaxes.bin

# Per-machine state, rewritten by the tool itself. gh keeps the auth
# token in the keychain, so hosts.yml is just the logged-in account.
gh/hosts.yml
cagent/

# k9s writes per-cluster state and screen dumps next to its config.
# The config and the generated skin are what we track; these are
# machine- and cluster-specific.
k8s/k9s/clusters/
k8s/k9s/benchmarks/
k8s/k9s/screen-dumps/

# Per-machine Ghostty overrides, included last by ghostty/config.
# Used to give macOS 26+ machines real macos-glass-* blur while the
# shared config keeps the numeric radius that works everywhere.
ghostty/local.conf

# Windows only — written/cloned by scripts/windows-setup
alacritty/local.toml
zsh/plugins/zsh-autosuggestions/
zsh/plugins/zsh-syntax-highlighting/
# scoop writes its config to $XDG_CONFIG_HOME/scoop — machine state
scoop/
# zsh completion cache
zsh/.zcompdump*
