# =========================================================
# Ghostty
#
# The daily driver. alacritty.toml is styled to match -- same palette,
# opacity, blur, padding, font and cursor -- and kept as the portable
# fallback. Ghostty wins on the things Alacritty lacks: the macOS 26
# glass material (see local.conf below), splits, tabs and shell
# integration. Keep the two in step when changing either.
#
# Colours live in theme.conf, which is GENERATED from
# theme/palettes/<name>.sh by scripts/theme. Switch with:
#
#     theme solarized-osaka
#
# then press ⌘⇧, to reload -- Ghostty has no CLI reload.
#
# Reference: https://ghostty.org/docs/config/reference
# =========================================================


# --- Palette ---------------------------------------------
# Leading ? makes the include optional, so a fresh checkout that has
# not run `theme regen` yet still starts (with Ghostty's defaults)
# instead of refusing to launch.
config-file = ?theme.conf


# --- The glass -------------------------------------------
# background-blur accepts a bool, an integer radius, or one of the
# macOS material names:
#
#   <integer>             blur radius; `true` == 20
#   macos-glass-regular   frosted material, macOS 26+ ONLY
#   macos-glass-clear     thinner material, macOS 26+ ONLY
#
# Deliberately numeric, not macos-glass-regular. The glass materials
# need macOS 26.0 or later, and -- this is the trap -- the config
# parser accepts them on older systems without complaint, so
# `+validate-config` passes and `+show-config` echoes the value back
# while the window silently renders a fallback. The result is a
# terminal that looks different on every machine depending on its
# macOS version, which is exactly what it did here: glass on 26+,
# something else on 15.x.
#
# 20 is the documented default radius and renders identically on every
# supported macOS, so both machines match. If every machine you use
# ends up on 26+, switching back to macos-glass-regular is a real
# upgrade -- the materials are NSVisualEffectView backing rather than
# a gaussian blur of the wallpaper, which keeps text legible over a
# busy desktop in a way a radius cannot.
#
# opacity and blur are a pair: blur does nothing at opacity = 1.0,
# and below about 0.80 comments start to fight the wallpaper.
background-opacity = 0.86
background-blur = 20

# Splits: dim the ones you are not in. Subtle -- this reads as depth
# rather than as a disabled pane.
unfocused-split-opacity = 0.92


# --- Window ----------------------------------------------
# Matching alacritty.toml's padding = { x = 14, y = 12 }. The generous
# padding is a large part of the look; text crammed against the window
# edge reads as cheap no matter what the palette is.
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true

# `hidden` is Ghostty's equivalent of Alacritty's decorations =
# "buttonless": no title bar, traffic lights only on hover.
macos-titlebar-style = hidden
window-colorspace = display-p3

# Inherit the working directory into new splits/tabs, not $HOME.
window-inherit-working-directory = true
window-inherit-font-size = true


# --- Font ------------------------------------------------
font-family = JetBrainsMono Nerd Font
font-size = 13.5

# Alacritty's [font.offset] y = 1 nudged the baseline for line
# breathing room; adjust-cell-height is the Ghostty equivalent and
# does it without clipping descenders.
adjust-cell-height = 8%

font-thicken = true


# --- Cursor ----------------------------------------------
# Beam + blink, as in alacritty.toml.
cursor-style = bar
cursor-style-blink = true


# --- Behaviour -------------------------------------------
scrollback-limit = 10000000
copy-on-select = clipboard
mouse-hide-while-typing = true
confirm-close-surface = false

# Scroll speed. Ghostty tracks the two input classes separately:
#
#   precision:  trackpads and the Magic Mouse -- continuous deltas
#   discrete:   a notched wheel -- one click at a time
#
# The defaults are precision:1 and discrete:3. On a Mac trackpad that
# leaves precision at 1x, which is why a long `git log` feels like
# wading -- the wheel path was already 3x and the trackpad path never
# was. 3 matches them up and is what makes a flick actually travel.
#
# Drop to 2 if it overshoots; the units are a plain multiplier, and
# fractions are allowed (precision:0.5 to slow it down).
mouse-scroll-multiplier = precision:3,discrete:3

# Left option stays Alt so zsh's Alt-C / Alt-B bindings work; right
# option is left alone for typing accented characters.
macos-option-as-alt = left

shell-integration = zsh
shell-integration-features = cursor,sudo,title


# --- Keybindings -----------------------------------------
# Shift+Enter sends a literal newline rather than submitting -- the
# same binding as alacritty.toml's "\r", needed by Claude Code
# and most REPLs.
keybind = shift+enter=text:\x1b\r

# No theme-cycling binding here on purpose: a `text:` keybind types
# into whatever has focus, so it would insert "theme next" into nvim
# or a REPL. Use the `theme` command, then ⌘⇧, to reload.


# --- Per-machine overrides -------------------------------
# MUST STAY LAST. Ghostty applies keys in the order it reads them, so
# the last assignment wins -- an include here can override anything
# above it, but one at the top could not.
#
# Gitignored, so each machine keeps its own and a fresh clone has none
# (the leading ? makes it optional, as with theme.conf).
#
# The case this exists for: background-blur above is the numeric 20,
# which renders identically everywhere. The macos-glass-* materials
# are better -- real NSVisualEffectView backing rather than a gaussian
# blur of the wallpaper -- but need macOS 26+, and they fail silently
# rather than loudly on older systems. So the shared config stays on
# the value that works everywhere, and the machines that can do better
# opt in locally:
#
#     # ~/.config/ghostty/local.conf on a macOS 26+ machine
#     background-blur = macos-glass-regular
#
# Then ⌘⇧, to reload.
config-file = ?local.conf
