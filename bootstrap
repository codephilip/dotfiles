#!/usr/bin/env bash
# =========================================================
# bootstrap — fresh Mac to working config
#
#   ./bootstrap          symlink configs, then report missing tools
#   ./bootstrap --check  report only, change nothing
#
# This repo IS $XDG_CONFIG_HOME (~/.config), so nvim, alacritty, tmux,
# starship and friends already sit at the paths their tools look in.
# Nothing to link for those. The only symlinks needed are the handful of
# files that must live outside ~/.config because their tool has no XDG
# support — that's the LINKS table below, and it should stay short.
#
# Idempotent: re-running is a no-op. Never clobbers a real file.
# =========================================================

set -uo pipefail

# Resolve the repo from this script's own location, not from $HOME/.config —
# so a clone sitting anywhere (~/dotfiles, a worktree) still links correctly.
CONFIG="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
CHECK_ONLY=0
[[ "${1:-}" == "--check" ]] && CHECK_ONLY=1

# repo-relative source : absolute target
LINKS=(
  "zsh/.zshrc:$HOME/.zshrc"
  "tmux/tmux.conf:$HOME/.tmux.conf"
  "git/gitconfig:$HOME/.gitconfig"
  "ssh/config:$HOME/.ssh/config"
)

# Tools the configs actually reference. Missing ones degrade gracefully
# (.zshrc guards every integration with `command -v`), so this reports
# rather than installs — you stay in control of what lands on the machine.
BREW_FORMULAE=(bat delta eza fd fzf lazygit neovim ripgrep starship tmux zoxide
               zsh-autosuggestions zsh-syntax-highlighting)

# Ghostty is the daily-driver terminal; Alacritty is the fallback. Only
# Ghostty can blur its background on macOS, which is the whole reason
# both are here — see ghostty/config.
BREW_CASKS=(ghostty alacritty font-jetbrains-mono-nerd-font)

red()   { printf '\033[31m%s\033[0m\n' "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
dim()   { printf '\033[2m%s\033[0m\n' "$*"; }
bold()  { printf '\033[1m%s\033[0m\n' "$*"; }

linked=0 created=0 skipped=0

link_one() {
  local src="$CONFIG/$1" target="$2"

  if [[ ! -e $src ]]; then
    # ssh/config is gitignored, so it legitimately may not exist on a
    # fresh clone. Not an error — just nothing to link.
    dim "  – ${1}: not in repo, nothing to link"
    ((skipped++))
    return
  fi

  if [[ -L $target ]]; then
    local current
    current=$(readlink "$target")
    if [[ $current == "$src" ]]; then
      green "  ✓ ${target/#$HOME/~} already linked"
      ((linked++))
      return
    fi
    red "  ! ${target/#$HOME/~} points elsewhere ($current)"
    dim "    remove it by hand if you want this repo's version"
    ((skipped++))
    return
  fi

  if [[ -e $target ]]; then
    # A real file, not a link. Could be the only copy of something —
    # refuse to touch it and let the user decide.
    red "  ! ${target/#$HOME/~} is a real file — left alone"
    dim "    back it up and re-run, or merge it into $1 yourself"
    ((skipped++))
    return
  fi

  if (( CHECK_ONLY )); then
    dim "  → would link ${target/#$HOME/~} -> ${src/#$HOME/~}"
    ((skipped++))
    return
  fi

  mkdir -p "$(dirname "$target")"
  ln -s "$src" "$target"
  green "  + linked ${target/#$HOME/~} -> ${src/#$HOME/~}"
  ((created++))
}

bold "Symlinks"
for entry in "${LINKS[@]}"; do
  link_one "${entry%%:*}" "${entry#*:}"
done

bold $'\nTools'
missing=()
for tool in "${BREW_FORMULAE[@]}"; do
  # The two zsh plugins are sourced by path, not run as commands.
  case $tool in
    zsh-autosuggestions)      probe=/opt/homebrew/share/zsh-autosuggestions ;;
    zsh-syntax-highlighting)  probe=/opt/homebrew/share/zsh-syntax-highlighting ;;
    neovim)                   probe=cmd:nvim ;;
    delta)                    probe=cmd:delta ;;
    # Formula name and binary name differ.
    ripgrep)                  probe=cmd:rg ;;
    *)                        probe="cmd:$tool" ;;
  esac

  if [[ $probe == cmd:* ]]; then
    command -v "${probe#cmd:}" &>/dev/null && continue
  else
    [[ -d $probe ]] && continue
  fi
  missing+=("$tool")
done

if (( ${#missing[@]} == 0 )); then
  green "  ✓ all ${#BREW_FORMULAE[@]} tools present"
else
  red "  ${#missing[@]} missing:"
  printf '    brew install %s\n' "${missing[*]}"
fi

bold $'\nCasks'
missing_casks=()
for cask in "${BREW_CASKS[@]}"; do
  case $cask in
    ghostty)                      probe=/Applications/Ghostty.app ;;
    alacritty)                    probe=/Applications/Alacritty.app ;;
    font-jetbrains-mono-nerd-font)
      # Fonts land in one of two places depending on whether Homebrew
      # installed them for the user or system-wide.
      if [[ -n $(/bin/ls "$HOME/Library/Fonts" /Library/Fonts 2>/dev/null \
                 | grep -i 'JetBrainsMonoNerdFont' | head -1) ]]; then
        continue
      fi
      probe='' ;;
  esac
  [[ -n $probe && -e $probe ]] && continue
  missing_casks+=("$cask")
done

if (( ${#missing_casks[@]} == 0 )); then
  green "  ✓ all ${#BREW_CASKS[@]} casks present"
else
  red "  ${#missing_casks[@]} missing:"
  printf '    brew install --cask %s\n' "${missing_casks[*]}"
fi

# --- Theme -----------------------------------------------
# theme/palettes/*.sh is the single source of truth for colours; the
# per-tool fragments (ghostty/theme.conf, alacritty/theme-current.toml,
# git/theme.gitconfig) are generated from it and gitignored, so a fresh
# clone has none of them. Generate them now, or Ghostty starts on its
# own default palette and delta falls back to bat's.
#
# This also fetches the tokyonight .tmTheme that bat needs, since bat
# ships Catppuccin and Solarized but not Tokyo Night.
bold $'\nTheme'
if [[ ! -x $CONFIG/scripts/theme ]]; then
  red "  ! scripts/theme missing or not executable"
elif (( CHECK_ONLY )); then
  dim "  → would run 'theme regen' for $("$CONFIG/scripts/theme" current)"
else
  if "$CONFIG/scripts/theme" regen; then
    green "  ✓ generated theme files for $("$CONFIG/scripts/theme" current)"
    dim "    switch with: theme list / theme <name>"
  else
    red "  ! theme regen failed"
  fi
fi

# --- macOS key repeat ------------------------------------
# Holding j/k in Neovim on a stock Mac crawls one line at a time. Two
# separate causes, both per-user macOS defaults rather than files, so
# neither can live in this repo and `make install` cannot carry them
# between machines -- which is exactly how one machine ends up feeling
# broken while another is fine.
#
#   KeyRepeat                 repeat interval; 1 is the fastest the UI
#                             offers, stock is 6 (~6x slower)
#   InitialKeyRepeat          delay before repeating starts
#   ApplePressAndHoldEnabled  when true, holding a key opens the accent
#                             picker INSTEAD of repeating -- this one is
#                             the real culprit, not the rate
#
# Reported, not written: these are system-wide and need a logout to
# apply, so they are yours to run. Same rule as the brew lists.
#
# NB: a green tick here only means the values are STORED. It cannot
# tell you the running login session is using them -- `defaults read`
# returns the new value the instant it is written, while the session
# keeps the old rate until you log out. Verified the hard way: an
# emulator launched 26 minutes after the write was still slow.
if [[ $OSTYPE == darwin* ]]; then
  bold $'\nmacOS key repeat'

  # key:target:description — flagged when unset, or slower than target.
  macos_fixes=()
  check_default() {
    local key=$1 target=$2 desc=$3 current
    current=$(defaults read -g "$key" 2>/dev/null)

    if [[ -z $current ]]; then
      macos_fixes+=("$key:$target:unset — $desc")
    elif [[ $key == ApplePressAndHoldEnabled ]]; then
      [[ $current != 0 ]] && macos_fixes+=("$key:$target:enabled — $desc")
    elif (( current > target )); then
      macos_fixes+=("$key:$target:$current — $desc")
    fi
  }

  check_default KeyRepeat                1  "repeat interval"
  check_default InitialKeyRepeat         15  "delay before repeat"
  check_default ApplePressAndHoldEnabled  0  "accent picker steals the repeat"

  if (( ${#macos_fixes[@]} == 0 )); then
    green "  ✓ key repeat values are stored"
    dim   "    (stored ≠ active — if j/k still crawls, you have not logged out)"
  else
    red "  ${#macos_fixes[@]} to fix — holding j/k in Neovim will crawl."
    dim "    FIRST: System Settings > Keyboard — drag 'Key Repeat Rate' to"
    dim "    the fastest notch and 'Delay Until Repeat' to the shortest."
    dim "    Writing the prefs without doing that does not take. Then run:"
    for fix in "${macos_fixes[@]}"; do
      key=${fix%%:*}; rest=${fix#*:}; target=${rest%%:*}; why=${rest#*:}
      dim "    $key ($why)"
      if [[ $key == ApplePressAndHoldEnabled ]]; then
        printf '    defaults write -g %s -bool false\n' "$key"
      else
        printf '    defaults write -g %s -int %s\n' "$key" "$target"
      fi
    done
    dim "    FINALLY: log out and back in. Relaunching the terminal is"
    dim "    not enough — macOS latches the rate for the login session."
  fi
fi

bold $'\nSummary'
printf '  %d already linked, %d created, %d skipped\n' "$linked" "$created" "$skipped"
(( CHECK_ONLY )) && dim "  (--check: nothing was changed)"

# ~/.zprofile is a real file managed by the Python installer, not this
# repo. Flag it so it doesn't silently shadow PATH changes in .zshrc.
if [[ -f $HOME/.zprofile && ! -L $HOME/.zprofile ]]; then
  dim $'\n  note: ~/.zprofile is unmanaged (Python installer wrote it) and'
  dim '        prepends to PATH before .zshrc runs.'
fi
